# ─── Serveur ────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── Base de données (PostgreSQL) ───────────────────────────
DATABASE_URL="postgresql://app:app@localhost:5432/app_dev?schema=public"

# ─── Auth (JWT) ─────────────────────────────────────────────
# 32 caractères minimum. Les valeurs d'exemple ci-dessous sont refusées au démarrage.
# Générer un secret : openssl rand -base64 48
JWT_SECRET="change-me-in-production-must-be-at-least-32-chars"
# Access token : priorité à JWT_ACCESS_EXPIRES_IN_MINUTES
JWT_ACCESS_EXPIRES_IN_MINUTES=15
# Repli si JWT_ACCESS_EXPIRES_IN_MINUTES absent
JWT_EXPIRES_IN_DAYS=7
JWT_REFRESH_EXPIRES_IN_DAYS=30

# ─── Seed (npm run prisma:seed) ─────────────────────────────
SEED_ADMIN_EMAIL=admin@app.local
SEED_ADMIN_PASSWORD=ChangeMe123!

# ─── Redis (cache, OTP, throttling partagé, BullMQ, verrous cron, Socket.IO) ─
REDIS_URL=redis://localhost:6379
CACHE_TTL_MINUTES=120

# ─── OTP (inscription / mot de passe oublié) ────────────────
OTP_TTL_SEC=300
OTP_RESEND_COOLDOWN_SEC=60
# Dev uniquement : log du code OTP côté serveur (refusé en production)
OTP_LOG_CODE=false
# Tests / Postman : renvoie le code dans la réponse (refusé en production)
OTP_RETURN_CODE_IN_RESPONSE=false

# ─── Rate limiting (@nestjs/throttler) ──────────────────────
THROTTLE_ENABLED=true
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
THROTTLE_SKIP_SWAGGER=true
# Routes d'auth (login/register). Défaut : 15/min en production, 100000 hors prod.
# Compteurs séparés : par IP et par e-mail/téléphone (AppThrottlerGuard).
# Ne pas fixer AUTH_THROTTLE_LIMIT=100000 en production (écraserait le défaut sûr).
# AUTH_THROTTLE_LIMIT=15
AUTH_THROTTLE_TTL_MS=60000
# Plusieurs instances : compteur partagé via Redis (recommandé en production)
THROTTLE_REDIS_ENABLED=false

# ─── HTTP ───────────────────────────────────────────────────
HTTP_JSON_BODY_LIMIT=1mb
HTTP_BASE64_UPLOAD_BODY_LIMIT=70mb
# true derrière un reverse proxy (Nginx, Railway, Cloudflare) pour récupérer la vraie IP
TRUST_PROXY=false
# Origines autorisées (séparées par des virgules). Hors production, localhost est toujours autorisé.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ─── Sécurité ───────────────────────────────────────────────
# IPs exactes ou plages IPv4 CIDR, séparées par des virgules
IP_BLOCK_ENABLED=false
IP_BLOCKLIST=
# Mode maintenance (1 = toutes les routes renvoient le statut applicatif 600)
MAINTENANCE_ENABLED=0

# ─── Clients mobiles : vérification de version ──────────────
VERSION_CHECK_ENABLED=0
IOS_MIN_VERSION=1.0.0
ANDROID_MIN_VERSION=1.0.0
# Header bypass-update-key pour contourner la vérification
VERSION_CHECK_BYPASS_KEY=

# ─── Socket.IO ──────────────────────────────────────────────
# Debug local uniquement : userId en clair au lieu du JWT (refusé en production)
SOCKET_AUTH_ALLOW_PLAIN_USERID=false
SOCKET_LOGS_ENABLED=false
SOCKET_LOG_JWT_PREVIEW=false

# ─── Documentation & logs ───────────────────────────────────
# Par défaut : activé hors production
SWAGGER_ENABLED=true
LOG_PAYLOADS=false
# Profilage des requêtes / requêtes Prisma lentes
PERF_PROFILING=0
PERF_SLOW_QUERY_MS=200
PERF_REQ_LOG_MS=500
PERF_SAMPLE_MS=2000

# ─── Uploads (Cloudinary) ───────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=app
UPLOAD_MAX_IMAGE_MB=5
UPLOAD_MAX_DOC_MB=10
UPLOAD_MAX_VIDEO_MB=50
# Listes MIME séparées par des virgules (vide = valeurs par défaut du service)
UPLOAD_ALLOWED_IMAGE_MIME=
UPLOAD_ALLOWED_DOC_MIME=
UPLOAD_ALLOWED_VIDEO_MIME=

# ─── Push (Firebase Cloud Messaging) ────────────────────────
# Désactivé automatiquement si les credentials sont absents
FIREBASE_PUSH_ENABLED=false
FIREBASE_DEFAULT_NOTIFICATION_TITLE=App
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# Clé multiligne : utiliser des \n ou des guillemets
FIREBASE_PRIVATE_KEY=

# ─── E-mails (SMTP) ─────────────────────────────────────────
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@example.com
SMTP_FROM_NAME=App
# Logo du header des e-mails (URL https publique)
EMAIL_LOGO_URL=
