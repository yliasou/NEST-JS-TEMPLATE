// Audit, analytics, push, email, notifications.

model AuditLog {
  id                 String       @id @default(cuid())
  actorUserId        String?
  targetUserId       String?
  requestId          String?
  action             AuditAction
  entity             AuditEntity?
  entityId           String?
  metadata           Json?
  ip                 String?
  latitude           Float?
  longitude          Float?
  locationAccuracy   Float?
  locationCapturedAt DateTime?
  userAgent          String?
  createdAt          DateTime     @default(now())

  actorUser  User? @relation("AuditLogActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  targetUser User? @relation("AuditLogTarget", fields: [targetUserId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([targetUserId])
  @@index([requestId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String?
  sessionId  String?
  name       String
  properties Json?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([name, createdAt])
  @@index([userId])
  @@index([sessionId])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  Platform
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, isActive])
}

model EmailLog {
  id         String         @id @default(cuid())
  userId     String?
  to         String
  subject    String
  template   String
  entityType String?
  entityId   String?
  status     EmailLogStatus @default(SENT)
  providerId String?
  error      String?
  sentAt     DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([template, sentAt])
  @@index([entityType, entityId])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  message   String
  metadata  Json?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead])
}
