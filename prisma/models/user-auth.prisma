// Utilisateurs, profils, permissions.

model User {
  id                 String       @id @default(cuid())
  email              String?      @unique
  phone              String?      @unique
  avatarUrl          String?
  passwordHash       String
  dateOfBirth        DateTime?
  gender             Gender?
  residentialAddress String?
  authProvider       AuthProvider @default(LOCAL)
  role               Role         @default(USER)
  isActive           Boolean      @default(true)
  emailVerifiedAt    DateTime?
  phoneVerifiedAt    DateTime?
  lastLoginAt        DateTime?
  /// Dernière requête authentifiée. N'alimente pas `updatedAt`.
  lastRequestAt      DateTime?
  /// Hash bcrypt d'un OTP réutilisable. Null si le compte n'en a pas.
  permanentOtpHash   String?
  /// Code OTP réutilisable renvoyé par send-code. Null si le compte n'en a pas.
  permanentOtpCode   String?
  deletedAt          DateTime?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  profile      UserProfile?
  adminProfile AdminProfile?

  notifications         Notification[]
  annonceReads          AnnonceRead[]
  newsletterSubscribers NewsletterSubscriber[]
  auditLogsAsActor      AuditLog[]             @relation("AuditLogActor")
  auditLogsAsTarget     AuditLog[]             @relation("AuditLogTarget")
  analyticsEvents       AnalyticsEvent[]
  pushTokens            PushToken[]
  emailLogs             EmailLog[]
  userPermissions       UserPermission[]
  examplesCreated       Example[]              @relation("ExampleCreatedBy")
  peopleCreated         Person[]               @relation("PersonCreatedBy")

  @@index([email])
  @@index([phone])
  @@index([role])
  @@index([isActive])
  @@index([lastRequestAt])
  @@index([authProvider])
}

model UserProfile {
  userId            String    @id
  firstName         String
  lastName          String
  preferredLanguage String    @default("fr")
  dateOfBirth       DateTime?
  address           String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AdminProfile {
  id         String     @id @default(cuid())
  userId     String     @unique
  level      AdminLevel @default(EMPLOYEE)
  department String?
  /// Permissions granulaires backoffice : { access: { isSuperAdmin, permissions } }
  metadata   Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Permission {
  id          String   @id @default(cuid())
  key         String   @unique
  label       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rolePermissions RolePermission[]
  userPermissions UserPermission[]
}

model RolePermission {
  id           String   @id @default(cuid())
  role         Role
  permissionId String
  createdAt    DateTime @default(now())

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([role, permissionId])
  @@index([permissionId])
}

model UserPermission {
  id           String   @id @default(cuid())
  userId       String
  permissionId String
  isGranted    Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([userId, permissionId])
  @@index([permissionId])
}
